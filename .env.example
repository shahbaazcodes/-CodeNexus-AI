GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-120b
MCP_BASE=http://127.0.0.1:8000
LLM_ENABLED=1
LLM_STUB=0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Shared Gemini quota control (free-tier safe defaults; all configurable)
GEMINI_MAX_CONCURRENT_REQUESTS=2
GEMINI_MAX_REQUESTS_PER_MINUTE=15
GEMINI_MAX_INPUT_TOKENS_PER_MINUTE=0
GEMINI_SAFETY_MARGIN=0.8
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_MAX_RETRIES=3
# Separate Groq fallback controls
GROQ_MAX_CONCURRENT_REQUESTS=2
GROQ_MAX_RETRIES=3
