GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-120b
MCP_BASE=http://127.0.0.1:8000
LLM_ENABLED=1
LLM_STUB=0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Shared Gemini quota control (free-tier safe defaults; all configurable)
GEMINI_MAX_CONCURRENT_REQUESTS=2
GEMINI_MAX_REQUESTS_PER_MINUTE=15
GEMINI_MAX_INPUT_TOKENS_PER_MINUTE=0
GEMINI_SAFETY_MARGIN=0.8
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_MAX_RETRIES=3
# Separate Groq fallback controls
GROQ_MAX_CONCURRENT_REQUESTS=2
GROQ_MAX_RETRIES=3

# ─── Demo API key (protects AI-consuming endpoints) ──────────────────────
# Supplied securely via deployment environment / SSM. Never hardcoded and
# never committed to Git.
CODENEXUS_API_KEY=your_demo_api_key_here

# ─── AI Usage Tracking & Token Cost Guard (demo) ─────────────────────────
# All usage counters are in-memory, reset on process restart, and scoped to
# this single application instance (not shared across ECS Fargate tasks).
# No API keys or credentials are stored or logged.

# Enable/disable the usage limit guard entirely.
AI_USAGE_LIMIT_ENABLED=1


# Maximum live AI requests per session in this process (0 = unlimited).
AI_MAX_REQUESTS_PER_SESSION=50

# Maximum estimated cost (USD) per session in this process (0 = unlimited).
AI_MAX_ESTIMATED_COST_PER_SESSION=1.00

# Maximum combined input+output tokens allowed per single request (0 = unlimited).
AI_MAX_TOKENS_PER_REQUEST=4000

# Estimated per-million-token pricing (USD). Replace with current provider
# list prices before any production claim. These are estimates only — never
# actual provider billing.
AI_PRICE_INPUT_GEMINI_3_6_FLASH=0.075
AI_PRICE_OUTPUT_GEMINI_3_6_FLASH=0.30
AI_PRICE_INPUT_GROQ_GPT_OSS_120B=0.50
AI_PRICE_OUTPUT_GROQ_GPT_OSS_120B=1.00
